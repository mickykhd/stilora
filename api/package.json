{
  "name": "hush-api",
  "version": "0.1.0",
  "description": "Backend for Hush — an open-source calm communication workspace (workspaces, channels, threads, DMs, reactions, pins, voice rooms).",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts up",
    "db:rollback": "bun src/db/migrate.ts down",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/protocol": "^1.53.1",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.6.0",
    "livekit-server-sdk": "^2.9.0",
    "postgres": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "bun-types": "^1.2.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.0"
  }
}
