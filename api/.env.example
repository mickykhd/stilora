# ---------------------------------------------------------------------------
# Stilora API — environment variables
# Copy to `.env` and fill in values:  cp .env.example .env
# Everything marked REQUIRED must be present or the app fails fast at boot.
# All other variables have safe defaults (feature simply stays disabled).
# ---------------------------------------------------------------------------

# --- Database (REQUIRED) ----------------------------------------------------
# Local dev (docker compose up -d):
DATABASE_URL=postgres://stilora:stilora@localhost:5432/stilora
# Neon production example:
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Better Auth (REQUIRED) -------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Public base URL of this API (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# --- Realtime (Ably) --------------------------------------------------------
# Optional. Without it the API runs with a no-op/in-memory bus (fine for dev & tests).
# Format: "appId.keyId:secret" from https://ably.com dashboard.
ABLY_API_KEY=

# --- LiveKit (voice rooms) --------------------------------------------------
# Optional. Without them /api/voice/* returns 503 until configured.
# e.g. LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Uploads (S3-compatible / Cloudflare R2) --------------------------------
# STORAGE_MODE=local -> no-op signer, no cloud account needed (default, dev/tests)
# STORAGE_MODE=s3    -> real SigV4 presigned PUT URLs (works with R2, AWS S3, MinIO)
STORAGE_MODE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Max upload size in bytes (default 25 MiB)
MAX_UPLOAD_BYTES=26214400

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Unknown origins are denied
# (403) and never receive Access-Control-* headers. BETTER_AUTH_URL's origin is
# always allowed. Example: https://app.example.com,http://localhost:5173
ALLOWED_ORIGINS=

# --- Rate limiting (in-process token buckets, per IP) -----------------------
# Limits are requests-per-minute. See src/ratelimit/limiter.ts
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_ROUTE_PER_MIN=120
RATE_LIMIT_GLOBAL_PER_MIN=600
# true  -> client IP taken from the first x-forwarded-for entry (Vercel / any
#          trusted reverse proxy). false -> all clients share one bucket.
TRUST_PROXY=true

# --- Limits & misc ----------------------------------------------------------
# Hard cap on request body size (bytes). Oversized bodies get 413.
MAX_BODY_BYTES=1048576
# Port for the local server (`bun run dev` / `bun start`). Ignored on Vercel.
PORT=3000
# Optional error tracking DSN (reserved for future Sentry/OpenTelemetry wiring;
# currently read, validated as optional, and not yet used to send anything).
SENTRY_DSN=
