# Hush Flutter app — build-time configuration (copy usage: --dart-define-from-file=env.json)

# Sentry DSN — leave empty to run with ZERO third-party telemetry (default).
# Create a free project at sentry.io and paste the DSN to enable crash reporting.
SENTRY_DSN=

# Phase-4 API base URL (until then the app runs on built-in mock repositories).
API_BASE_URL=https://your-api.vercel.app

# Ably realtime key (publish/subscribe for typing, presence, voice state).
ABLY_KEY=

# LiveKit (cloud free tier) — used to mint voice room tokens via the API.
LIVEKIT_URL=wss://your-project.livekit.cloud
